{
  "name": "@oct8/octorepo",
  "version": "0.1.0",
  "description": "Scaffold multi-app Node/TypeScript monorepos (Nx or Turborepo) with frontends, backends and Docker Compose",
  "keywords": [
    "monorepo",
    "scaffold",
    "cli",
    "turborepo",
    "nx",
    "pnpm",
    "nextjs",
    "nestjs",
    "express",
    "vite",
    "docker-compose",
    "typescript",
    "generator"
  ],
  "homepage": "https://github.com/oct8-studio/octorepo#readme",
  "bugs": {
    "url": "https://github.com/oct8-studio/octorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oct8-studio/octorepo.git"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "bin": {
    "octorepo": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run",
    "lint": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
